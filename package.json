{
  "name": "@an-an-618/dsh-glossary",
  "version": "0.2.1",
  "description": "Glossary for DeepSeek Harness: the model appends a term block to each reply, and the Client turns hard words in the answer into clickable dashed terms with an instant definition card.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "glossary",
    "term",
    "definition",
    "chat-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/an-an-618/dsh-glossary.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "showcase/*.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
